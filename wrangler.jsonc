{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hghub-video",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-worker",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/", "/app", "/app/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hghub-video-db", "migrations_dir": "worker/migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_HASHER", "class_name": "PasswordHasher" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PasswordHasher"] }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "619723", "simple": { "limit": 12, "period": 60 } }
  ]
}
